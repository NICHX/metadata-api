# Media Renamer API 配置
# 将此文件复制为 .env 并填入你的密钥

# TMDb API 密钥（从 https://www.themoviedb.org/settings/api 获取）
MEDIA_RENAMER_TMDB_API_KEY=

# Bangumi API 密钥（从 https://bgm.tv/oauth/register 获取）
MEDIA_RENAMER_BGM_API_KEY=

# AI API 密钥（OpenAI 兼容，用于 AI 从目录路径推断剧名，例：DeepSeek https://api.deepseek.com）
MEDIA_RENAMER_AI_API_KEY=